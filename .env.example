# Template sem credenciais reais. Copie para .env e substitua os placeholders.
# O frontend funciona sem backend ou PostgreSQL.
POSTGRES_USER=life_rpg
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
POSTGRES_DB=life_rpg
POSTGRES_PORT=5432
DATABASE_URL=postgresql://life_rpg:CHANGE_ME_LOCAL_ONLY@localhost:5432/life_rpg?schema=public
PORT=3001
WEB_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3001
