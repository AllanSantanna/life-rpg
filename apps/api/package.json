{
  "name": "@life-rpg/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/server.ts",
    "start": "dotenv -e ../../.env -- node dist/server.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:validate": "dotenv -e ../../.env -- prisma validate"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.0.0",
    "helmet": "^8.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.0",
    "prisma": "^7.10.1",
    "supertest": "^7.0.0",
    "tsx": "^4.0.0",
    "vitest": "^4.1.12"
  }
}
